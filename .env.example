# Supabase / Postgres connection — required
# Point these at ANY Supabase project (Lovable Cloud, self-hosted, or supabase.com).
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_or_anon_key"
SUPABASE_PROJECT_ID="your-project-ref"

# Same values, exposed to the browser bundle via Vite
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_or_anon_key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Lovable AI Gateway (optional — powers the "AI field brief")
# Get a key at https://lovable.dev or swap for any OpenAI-compatible endpoint.
LOVABLE_API_KEY=""
